      document.querySelectorAll('#rb-acts .chip').forEach(b => b.classList.toggle('on', b.dataset.act === act)); }
    $('rb-name').value = myName; $('rb-task').value = myTask;
    document.querySelectorAll('#rb-acts .chip').forEach(b => b.onclick = () => { act = b.dataset.act; store.set('hridal.room.act', act); showSeated(!!seat); });
    $('rb-seat').onsubmit = async e => {
      e.preventDefault();
      myName = $('rb-name').value.trim().slice(0, 20); myTask = $('rb-task').value.trim().slice(0, 50); store.set('hridal.room.name', myName);
      const first = !seat;
      if (first) { seat = rid(); seatedAt = Date.now(); }
      const cat = act === 'Just vibing' ? 'Study' : act;
      if (first && $('rb-log').checked && window.__focusApi) logged = window.__focusApi.start(cat, myTask || act);
      else if (logged && window.__focusApi) window.__focusApi.note(myTask || act);
      remember(); showSeated();
      const r = await call(seatBody());
      if (!r.ok) { if (first) { seat = null; remember(); showSeated(); } $('rb-note').hidden = false; $('rb-note').textContent = (r.j && r.j.error) || 'Couldn’t take a seat just now.'; return; }
      const me = (r.j.people || []).find(p => p.id === seat);
      const hid = me && ((myName && !me.name) || (myTask && !me.task));
      $('rb-note').hidden = !hid; $('rb-note').textContent = hid ? 'Links and some words can’t be shown in the room, so it shows what you picked instead.' : '';
    };
    $('rb-edit').onclick = () => showSeated(true);
    $('rb-leave').onclick = () => { const id = seat; seat = null; if (logged && window.__focusApi) window.__focusApi.finish(); logged = false; remember(); showSeated(); call({ action: 'leave', id }); };
    addEventListener('pagehide', () => { if (seat && navigator.sendBeacon) navigator.sendBeacon('/api/room', new Blob([JSON.stringify({ action: 'leave', id: seat })], { type: 'application/json' })); });

    // Keep in touch with the room while the page is open: a heartbeat if seated, otherwise a quiet check.
    const poll = () => { if (document.hidden) return; seat ? call(seatBody()) : call(); };
    setInterval(poll, 25000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) poll(); });
    (seat ? call(seatBody()) : call()).catch(closed);

    // ---------- ambient sound ----------
    let ctx = null, nodes = [];
    function noise(kind) {
      const len = ctx.sampleRate * 4, buf = ctx.createBuffer(1, len, ctx.sampleRate), d = buf.getChannelData(0); let last = 0;
      for (let i = 0; i < len; i++) { const w = Math.random() * 2 - 1; if (kind === 'brown') { last = (last + 0.02 * w) / 1.02; d[i] = last * 3.5; } else d[i] = w; }
      const src = ctx.createBufferSource(); src.buffer = buf; src.loop = true; return src;
    }
    function sound(kind) {
      nodes.forEach(n => { try { n.stop ? n.stop() : n.disconnect(); } catch (e) {} }); nodes = [];
      clearTimeout(sound.clink); room.dataset.sound = kind;
      if (kind === 'off') return;
      ctx = ctx || new (window.AudioContext || window.webkitAudioContext)(); ctx.resume();
      const out = ctx.createGain(); out.gain.value = 0; out.gain.linearRampToValueAtTime(kind === 'rain' ? .16 : .22, ctx.currentTime + 1.2); out.connect(ctx.destination); nodes.push(out);
      if (kind === 'rain') {
        const n = noise('white'), bp = ctx.createBiquadFilter(), lp = ctx.createBiquadFilter(); bp.type = 'highpass'; bp.frequency.value = 500; lp.type = 'lowpass'; lp.frequency.value = 2600;
        n.connect(bp).connect(lp).connect(out); n.start(); nodes.push(n);
        const lo = noise('brown'), g = ctx.createGain(); g.gain.value = .5; lo.connect(g).connect(out); lo.start(); nodes.push(lo);
      } else {
        const n = noise('brown'), lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 520; n.connect(lp).connect(out); n.start(); nodes.push(n);
        const clink = () => { const o = ctx.createOscillator(), g = ctx.createGain(), t = ctx.currentTime; o.frequency.value = 1800 + Math.random() * 1400; g.gain.setValueAtTime(.025, t); g.gain.exponentialRampToValueAtTime(.0001, t + .35); o.connect(g).connect(out); o.start(t); o.stop(t + .4); sound.clink = setTimeout(clink, 3000 + Math.random() * 7000); };
        sound.clink = setTimeout(clink, 2500);
      }
    }
    document.querySelectorAll('#rb-sound .chip').forEach(b => b.onclick = () => { document.querySelectorAll('#rb-sound .chip').forEach(x => x.classList.toggle('on', x === b)); sound(b.dataset.s); });

    // ---------- Hridal's side: her timer tells the room what she's doing ----------
    const panel = $('host-panel');
    const share = () => $('hp-share').checked;
    $('hp-task').value = store.get('hridal.room.task', '');
    $('hp-share').checked = store.get('hridal.room.share', '1') === '1';
    function hostUI() { const on = !!key; panel.hidden = !on; $('host-open').hidden = on; $('host-form').hidden = true; room.classList.toggle('is-host', on); }
    async function broadcast(type, detail) {
      if (!key) return;
      const now = window.__focusNow ? window.__focusNow() : {};
      const d = detail || now;
      let body;
      if (type === 'finish') body = { action: 'finish', minutes: d.minutes, cat: d.cat && d.cat.name, task: $('hp-task').value.trim(), day: new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/London' }).format(new Date()) };
      else if (type === 'change' && !d.run) return; // opening the page on another device shouldn't switch the room off
      else if (type === 'off' || !share()) body = { action: 'off' };
      else body = { action: 'live', task: $('hp-task').value.trim(), cat: d.cat && d.cat.name, color: d.cat && d.cat.color, elapsed: d.elapsed, paused: d.run.paused, target: d.run.target || 0 };
      const r = await call(body, true);
      if (r.status === 401) { key = ''; hostUI(); $('host-msg').textContent = 'Signed out. Sign in again to broadcast.'; return; }
      $('hp-msg').textContent = !r.ok ? 'Couldn’t reach the room. It’ll try again shortly.' : body.action === 'live' ? (d.run.paused ? 'The room sees you’re on a break.' : 'The room can see you’re studying.') : body.action === 'finish' && d.minutes >= 1 ? `Added ${mins(d.minutes)} to your week in the room.` : 'The room sees you’re not studying.';
    }
    ['change', 'finish', 'off'].forEach(t => addEventListener('focus:' + t, e => broadcast(t, e.detail)));
    $('hp-share').onchange = () => { store.set('hridal.room.share', share() ? '1' : '0'); broadcast('change'); };
    $('hp-task').onchange = () => { store.set('hridal.room.task', $('hp-task').value.trim()); broadcast('change'); };
    setInterval(() => { const n = window.__focusNow && window.__focusNow(); if (key && n && n.run && share()) broadcast('change'); }, 45000);
    $('host-open').onclick = () => { $('host-form').hidden = false; $('host-open').hidden = true; $('host-pass').focus(); };
    $('host-form').onsubmit = async e => {
      e.preventDefault(); $('host-msg').textContent = 'Checking…';
      const r = await window.hridalAuth.login($('host-pass').value); $('host-pass').value = '';
      if (r.ok) { key = 'signed-in'; $('host-msg').textContent = ''; hostUI(); broadcast('change'); panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }); }
      else $('host-msg').textContent = r.error || 'Couldn’t sign in.';
    };
    $('host-out').onclick = async () => { await broadcast('off'); key = ''; await window.hridalAuth.logout(); hostUI(); };
    hostUI(); showSeated();
    window.hridalAuth.status().then(on => { if (on) { key = 'signed-in'; hostUI(); broadcast('change'); } });
  })();
  </script>
</Base>
