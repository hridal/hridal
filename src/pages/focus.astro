---
import Base from '../layouts/Base.astro';
---
<Base title="Study with me" description="Study with Hridal: see when she's studying and what on, take a seat in the room, and keep your own timer, calendar and to-do list.">
  <div class="tab-page focus">
    <section class="block stacked-full tool-page">
      <h2>Study with me</h2>
      <div>
        <p class="lead-small">When I'm studying, the lamp in this room is on and you can see what I'm working on. Pull up a chair, pick what you're doing, and study alongside me and anyone else who's here. Below the room there's a desk of your own, with a timer, calendar and to-do list that save privately in your browser.</p>

        <!-- The room -->
        <div class="room" id="room" data-live="false" data-tod="day">
          <div class="room-status" aria-live="polite">
            <p class="rs-badge"><i class="rs-dot"></i><span id="rs-badge">Checking the room…</span></p>
            <p class="rs-line" id="rs-line">&nbsp;</p>
            <p class="rs-sub" id="rs-sub">&nbsp;</p>
          </div>

          <svg class="room-scene" viewBox="0 0 800 330" role="img" aria-label="An illustrated study room with a long desk, a window and a bookshelf">
            <defs>
              <linearGradient id="sky-dawn" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f2c6b4"/><stop offset="1" stop-color="#fbe7c8"/></linearGradient>
              <linearGradient id="sky-day" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b9d3e4"/><stop offset="1" stop-color="#e6eff2"/></linearGradient>
              <linearGradient id="sky-dusk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5b4a73"/><stop offset="1" stop-color="#e59a7a"/></linearGradient>
              <linearGradient id="sky-night" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1d2440"/><stop offset="1" stop-color="#3a3f63"/></linearGradient>
              <radialGradient id="lamp-glow"><stop offset="0" stop-color="#ffd98a" stop-opacity=".75"/><stop offset="1" stop-color="#ffd98a" stop-opacity="0"/></radialGradient>
              <clipPath id="win-clip"><rect x="318" y="34" width="164" height="128" rx="3"/></clipPath>
            </defs>
            <rect class="r-wall" width="800" height="330"/>
            <rect class="r-floor" y="268" width="800" height="62"/>
            <!-- window -->
            <g clip-path="url(#win-clip)">
              <rect class="r-sky" x="318" y="34" width="164" height="128"/>
              <g class="r-stars"><circle cx="340" cy="52" r="1.2"/><circle cx="372" cy="70" r="1"/><circle cx="410" cy="48" r="1.3"/><circle cx="452" cy="64" r="1"/><circle cx="468" cy="96" r="1.2"/><circle cx="350" cy="104" r="1"/></g>
              <circle class="r-sun" cx="452" cy="66" r="13"/>
              <path class="r-roofs" d="M318 162 V132 h22 v-14 h18 v20 h16 v-26 l12 -10 l12 10 v26 h20 v-18 h26 v12 h18 v-22 h20 v42 z"/>
              <g class="r-rain">{Array.from({ length: 22 }, (_, i) => <line x1={322 + (i * 37) % 160} y1={(i * 53) % 120 + 30} x2={316 + (i * 37) % 160} y2={(i * 53) % 120 + 46} />)}</g>
            </g>
            <rect class="r-frame" x="314" y="30" width="172" height="136" rx="5"/>
            <line class="r-mullion" x1="400" y1="34" x2="400" y2="162"/><line class="r-mullion" x1="318" y1="98" x2="482" y2="98"/>
            <rect class="r-sill" x="306" y="164" width="188" height="7" rx="2"/>
            <!-- bookshelf -->
            <g class="r-shelf">
              <rect x="44" y="46" width="150" height="176" rx="3" class="r-wood"/>
              <rect x="52" y="54" width="134" height="160" class="r-shelf-in"/>
              <line x1="52" y1="108" x2="186" y2="108"/><line x1="52" y1="162" x2="186" y2="162"/>
              <g class="r-books">
                <rect x="58" y="70" width="10" height="38" fill="#6c202d"/><rect x="70" y="64" width="12" height="44" fill="#a9845f"/><rect x="84" y="74" width="8" height="34" fill="#5f6f8a"/><rect x="94" y="68" width="11" height="40" fill="#c06c7a"/><rect x="116" y="80" width="30" height="8" fill="#7d8a6a"/><rect x="118" y="88" width="28" height="9" fill="#d19a6a"/><rect x="118" y="97" width="30" height="11" fill="#6c202d"/>
                <rect x="60" y="126" width="9" height="36" fill="#4f7a7a"/><rect x="71" y="120" width="12" height="42" fill="#6c202d"/><rect x="85" y="128" width="10" height="34" fill="#d19a6a"/><rect x="110" y="122" width="9" height="40" fill="#9a5a8a"/><rect x="121" y="126" width="12" height="36" fill="#a9845f" transform="rotate(12 127 162)"/>
                <rect x="58" y="178" width="12" height="36" fill="#5f6f8a"/><rect x="72" y="172" width="10" height="42" fill="#c06c7a"/><rect x="84" y="180" width="11" height="34" fill="#7d8a6a"/><circle cx="150" cy="196" r="12" class="r-globe"/><line x1="150" y1="208" x2="150" y2="214"/>
              </g>
            </g>
            <!-- plant -->
            <g class="r-plant" transform="translate(28 0)"><path d="M690 268 l6 -40 h32 l6 40 z" class="r-pot"/><path d="M712 230 C 700 200, 676 196, 668 178 C 690 184, 706 200, 712 226 M712 228 C 714 196, 722 170, 742 158 C 738 186, 726 206, 714 228 M712 228 C 724 206, 748 200, 764 204 C 750 216, 730 222, 714 230"/></g>
            <circle class="r-glow" cx="372" cy="196" r="120" fill="url(#lamp-glow)"/>
            <!-- seats (behind the desk) -->
            <g id="seats"></g>
            <!-- desk -->
            <rect class="r-desk" x="40" y="236" width="720" height="14" rx="3"/>
            <rect class="r-desk-front" x="40" y="250" width="720" height="8"/>
            <rect class="r-leg" x="64" y="258" width="10" height="56"/><rect class="r-leg" x="726" y="258" width="10" height="56"/>
            <!-- Hridal's spot -->
            <g class="r-host">
              <path class="r-lamp" d="M330 236 h26 M343 236 V214 L360 182 M360 182 l-14 -10 l18 -14 l12 18 z"/>
              <!-- The laptop faces Hridal: we see the back of its lid, tilted away from us, with her arms reaching
                   round to the keyboard on her side and the screen's light on her face. -->
              <g class="r-arms"><path d="M379 204 C 376 216, 381 228, 391 232"/><path d="M421 204 C 424 216, 419 228, 409 232"/></g>
              <path class="r-spill" d="M386 210.4 h28"/>
              <path class="r-laptop" d="M382 234.2 V213.5 a2.5 2.5 0 0 1 2.5 -2.5 h31 a2.5 2.5 0 0 1 2.5 2.5 V234.2 z"/>
              <rect class="r-logo" x="397.6" y="220.2" width="4.8" height="4.8" rx=".6"/>
              <rect class="r-laptop-base" x="381" y="234.2" width="38" height="1.8" rx=".9"/>
              <path class="r-mug" d="M440 222 h16 v12 a3 3 0 0 1 -3 3 h-10 a3 3 0 0 1 -3 -3 z M456 225 c6 0 6 8 0 8"/>
              <g class="r-steam"><path d="M445 218 c-3 -5 3 -7 0 -12"/><path d="M451 218 c-3 -5 3 -7 0 -12"/></g>
              <text class="r-tag" x="400" y="272">Hridal</text>
            </g>
            <text class="r-more" id="r-more" x="752" y="296" text-anchor="end"></text>
          </svg>

          <div class="room-bar">
            <form class="rb-seat" id="rb-seat">
              <p class="rb-q">Take a seat. What are you studying?</p>
              <div class="chips" id="rb-acts">{['Revising', 'Coursework', 'Problem sheets', 'Lecture catch-up', 'Lab report', 'Essay writing', 'Reading', 'Coding', 'Just vibing'].map(a => <button class="chip" type="button" data-act={a}>{a}</button>)}</div>
              <div class="rb-fields">
                <input id="rb-name" maxlength="20" placeholder="Your name (optional)" aria-label="Your name, optional" autocomplete="given-name" />
                <input id="rb-task" maxlength="50" placeholder="What exactly? (optional)" aria-label="What you're working on, optional" />
                <button class="btn solid small" type="submit">Sit down</button>
              </div>
              <label class="rb-log"><input type="checkbox" id="rb-log" checked /> Add this time to my calendar on the desk below</label>
            </form>
            <div class="rb-seated" id="rb-seated" hidden>
              <p class="rb-q">You're in the room, <b id="rb-act"></b>. <span class="rb-time" id="rb-time">0:00</span></p>
              <button class="btn ghost small" type="button" id="rb-edit">Change</button>
              <button class="btn ghost small" type="button" id="rb-leave">Leave your seat</button>
              <p class="rb-note" id="rb-note" hidden></p>
            </div>
            <div class="rb-sound">
              <p class="rb-q">Sound</p>
              <div class="chips" id="rb-sound"><button class="chip on" type="button" data-s="off">Off</button><button class="chip" type="button" data-s="rain">Rain</button><button class="chip" type="button" data-s="cafe">Café</button></div>
            </div>
          </div>

          <div class="room-who" id="room-who" hidden>
            <p class="rw-head"><span>In the room</span></p>
            <ul id="who-list"></ul>
          </div>

          <div class="room-week" id="room-week" hidden>
            <p class="rw-head"><span>My week in the room</span><b id="rw-total"></b></p>
            <div class="rw-bars" id="rw-bars"></div>
          </div>

          <div class="room-host-entry">
            <button class="link-btn" type="button" id="host-open">Hridal? Sign in</button>
            <form class="host-form" id="host-form" hidden>
              <input type="password" id="host-pass" placeholder="Password" autocomplete="current-password" aria-label="Password" />
              <button class="btn solid small" type="submit">Sign in</button>
              <span class="host-msg" id="host-msg"></span>
            </form>
          </div>
        </div>

        <h3 class="desk-head">Your desk</h3>

        <div class="f-grid">
          <!-- Timer -->
          <div class="f-card timer-card">
            <p class="eyebrow">What are you studying?</p>
            <div class="cat-row">
              <select id="cat-select" aria-label="Type of study"></select>
              <button class="btn ghost small" id="cat-add-toggle" aria-expanded="false" aria-controls="cat-manage">Edit types</button>
            </div>
            <div class="cat-manage" id="cat-manage" hidden>
              <p class="cm-head">Your types of study <span>Rename, recolour or remove them, or add your own.</span></p>
              <ul class="cm-list" id="cat-list"></ul>
              <form class="cat-new" id="cat-new">
                <input id="cat-name" placeholder="Add a type, e.g. Dissertation, Group project" maxlength="40" aria-label="New type of study" />
                <button class="btn solid small" type="submit">Add</button>
              </form>
              <p class="cm-msg" id="cm-msg" aria-live="polite"></p>
            </div>

            <div class="clock" id="clock">00:00:00</div>
            <div class="seg" id="targets" role="group" aria-label="Session length">
              <i class="seg-pill" aria-hidden="true"></i>
              <button class="chip on" data-min="0">No limit</button>
              <button class="chip" data-min="25">25 min</button>
              <button class="chip" data-min="50">50 min</button>
              <button class="chip" data-min="90">90 min</button>
            </div>
            <div class="t-deck">
              <button class="tc tc-side" id="reset" disabled>
                <span class="tc-disc" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4.8h6V7M6.5 7l.9 12.2h9.2l.9-12.2M10 11v5M14 11v5"/></svg></span>
                <span class="tc-lbl">Discard</span>
              </button>
              <button class="tc tc-main" id="start" data-state="play">
                <span class="tc-disc" aria-hidden="true">
                  <svg class="tc-ring" viewBox="0 0 100 100"><circle class="tr-bg" cx="50" cy="50" r="46" /><circle class="tr-fg" cx="50" cy="50" r="46" pathLength="100" /></svg>
                  <svg class="tc-play" viewBox="0 0 24 24"><path d="M8.5 5.8v12.4a.8.8 0 0 0 1.2.7l9.6-6.2a.8.8 0 0 0 0-1.4L9.7 5.1a.8.8 0 0 0-1.2.7z"/></svg>
                  <svg class="tc-pause" viewBox="0 0 24 24"><rect x="6.5" y="5" width="3.8" height="14" rx="1.2"/><rect x="13.7" y="5" width="3.8" height="14" rx="1.2"/></svg>
                </span>
                <span class="tc-lbl">Start</span>
              </button>
              <button class="tc tc-side tc-save" id="stop" disabled>
                <span class="tc-disc" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                <span class="tc-lbl">Finish &amp; save</span>
              </button>
            </div>
            <p class="t-status" id="t-status"></p>
            <div class="host-panel" id="host-panel" hidden>
              <label class="hp-share"><input type="checkbox" id="hp-share" checked /> Show this session in the room</label>
              <input id="hp-task" maxlength="80" placeholder="What visitors see, e.g. Nanomaterials problem sheet" aria-label="What visitors see" />
              <p class="hp-msg" id="hp-msg"></p>
              <p class="vault-note" id="vault-note" aria-live="polite"></p>
              <button class="link-btn" type="button" id="host-out">Sign out</button>
            </div>
          </div>

          <!-- Stats -->
          <div class="f-card stats-card">
            <p class="eyebrow">This week</p>
            <p class="big-num" id="week-total">0h 0m</p>
            <p class="sub" id="today-total">Today: 0m</p>
            <div id="cat-bars" class="cat-bars"></div>
          </div>
        </div>

        <!-- Calendar -->
        <div class="f-card cal-card">
          <div class="cal-head">
            <button class="btn ghost small" id="prev" aria-label="Previous month">←</button>
            <h3 id="cal-title"></h3>
            <button class="btn ghost small" id="next" aria-label="Next month">→</button>
          </div>
          <div class="cal-dow"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
          <div class="cal-grid" id="cal-grid"></div>
          <div class="cal-key"><span><i class="k0"></i>none</span><span><i class="k1"></i>&lt;1h</span><span><i class="k2"></i>1–3h</span><span><i class="k3"></i>3h+</span><span><i class="dot"></i>to-do due</span></div>
          <div class="day-panel" id="day-panel" hidden></div>
        </div>

        <!-- To-do -->
        <div class="f-card todo-card">
          <p class="eyebrow">To-do list</p>
          <form class="todo-form" id="todo-form">
            <input id="todo-text" placeholder="What needs doing?" required maxlength="120" />
            <input id="todo-date" type="date" aria-label="Due date" />
            <select id="todo-cat" aria-label="Type of study"></select>
            <button class="btn solid small" type="submit">Add</button>
          </form>
          <p class="sub">Your list sorts itself by deadline, and anything with a date shows up on the calendar.</p>
          <div id="todo-list"></div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
  (() => {
    const K = { cats: 'hridal.focus.cats', sessions: 'hridal.focus.sessions', todos: 'hridal.focus.todos', run: 'hridal.focus.running' };
    const load = (k, d) => { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } };
    let vault = null;
    const save = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} if (vault) vault.touch(k, v); };
    const palette = ['#6c202d', '#c06c7a', '#a9845f', '#7d8a6a', '#5f6f8a', '#9a5a8a', '#d19a6a', '#4f7a7a'];

    // Types of study. Older saves had Study / Work / Reading; those are renamed and the uni ones added.
    const DEFAULT_CATS = [{ id: 'study', name: 'Revision' }, { id: 'work', name: 'Coursework' }, { id: 'sheets', name: 'Problem sheets' }, { id: 'lectures', name: 'Lecture catch-up' }, { id: 'labs', name: 'Lab reports' }, { id: 'reading', name: 'Reading' }].map((c, i) => ({ ...c, color: palette[i % palette.length] }));
    let cats = load(K.cats, DEFAULT_CATS);
    const RENAME = { study: ['Study', 'Revision'], work: ['Work', 'Coursework'] };
    let catsChanged = false;
    cats.forEach(c => { const r = RENAME[c.id]; if (r && c.name === r[0]) { c.name = r[1]; catsChanged = true; } });
    if (!load('hridal.focus.uniCats', false)) { DEFAULT_CATS.forEach(d => { if (!cats.some(c => c.id === d.id)) { cats.push({ ...d, color: palette[cats.length % palette.length] }); catsChanged = true; } }); save('hridal.focus.uniCats', true); }
    let sessions = load(K.sessions, []);
    let todos = load(K.todos, []);
    let run = load(K.run, null); // { cat, startedAt, accumulated, paused, target }
    let target = run ? run.target || 0 : 0;
    // While Hridal is signed in, her sessions, to-dos, types of work and any running timer are also saved to the site.
    vault = window.hridalVault && window.hridalVault('focus', {
      lists: { [K.cats]: (a, b) => (a._t || 0) - (b._t || 0), [K.sessions]: (a, b) => new Date(a.end) - new Date(b.end), [K.todos]: (a, b) => a.id - b.id },
      ones: [K.run],
      apply() {
        cats = load(K.cats, cats); sessions = load(K.sessions, []); todos = load(K.todos, []); run = load(K.run, null);
        if (run) target = run.target || 0;
        renderCats(); if (run) $('cat-select').value = run.cat; renderAll(); syncButtons(); tick();
      },
      onState: (s) => { const el = document.getElementById('vault-note'); if (!el) return; el.dataset.s = s;
      el.textContent = s === 'saving' ? 'Saving to your account…' : s === 'saved' ? 'Saved to your account, so it’s on every device you sign in on.' : s === 'error' ? 'Couldn’t reach your account just now. It’s safe on this device and will try again.' : ''; },
    });
    if (catsChanged) save(K.cats, cats);
    let viewMonth = new Date(); viewMonth.setDate(1);
    let chimed = false;

    const $ = id => document.getElementById(id);
    const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const dkey = d => { const x = new Date(d); return `${x.getFullYear()}-${String(x.getMonth() + 1).padStart(2, '0')}-${String(x.getDate()).padStart(2, '0')}`; };
    const todayKey = () => dkey(new Date());
    const fmtMin = m => { m = Math.round(m); const h = Math.floor(m / 60); return h ? `${h}h ${m % 60}m` : `${m}m`; };
    const catOf = id => cats.find(c => c.id === id) || { name: 'Other', color: '#999' };

    /* ---------- categories ---------- */
    function renderCats() {
      const live = cats.filter(c => !c.hidden);
      const opts = live.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
      $('cat-select').innerHTML = opts;
      $('todo-cat').innerHTML = '<option value="">No type</option>' + opts;
      if (run) $('cat-select').value = run.cat;
      renderManage();
    }
    // Managing types: rename (type and press Enter or click away), tap the dot to change colour, × to remove.
    // A removed type that's already in your history is only hidden, so past sessions keep their name.
    function renderManage() {
      const live = cats.filter(c => !c.hidden);
      $('cat-list').innerHTML = live.map(c => `<li>
        <button type="button" class="cm-dot" data-col="${c.id}" style="--c:${c.color}" aria-label="Change colour of ${esc(c.name)}"></button>
        <input data-ren="${c.id}" value="${esc(c.name)}" maxlength="40" aria-label="Name" />
        <button type="button" class="x" data-rm="${c.id}" aria-label="Remove ${esc(c.name)}" ${live.length < 2 ? 'disabled' : ''}>×</button></li>`).join('');
      $('cat-list').querySelectorAll('[data-col]').forEach(b => b.onclick = () => { const c = cats.find(x => x.id === b.dataset.col); c.color = palette[(palette.indexOf(c.color) + 1) % palette.length]; save(K.cats, cats); renderCats(); renderAll(); });
      $('cat-list').querySelectorAll('[data-ren]').forEach(inp => {
        const commit = () => { const c = cats.find(x => x.id === inp.dataset.ren), v = inp.value.trim(); if (!c) return; if (!v) { inp.value = c.name; return; } if (v !== c.name) { c.name = v; save(K.cats, cats); renderCats(); renderAll(); cmMsg('Renamed.'); } };
        inp.onchange = commit; inp.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); inp.blur(); } };
      });
      $('cat-list').querySelectorAll('[data-rm]').forEach(b => b.onclick = () => {
        const id = b.dataset.rm;
        if (run && run.cat === id) { cmMsg('That one’s on the timer right now. Finish first, then remove it.'); return; }
        const used = sessions.some(x => x.cat === id) || todos.some(x => x.cat === id);
        if (used) cats.find(x => x.id === id).hidden = true; else cats = cats.filter(x => x.id !== id);
        save(K.cats, cats); renderCats(); renderAll(); cmMsg(used ? 'Removed. Past sessions keep their name.' : 'Removed.');
      });
    }
    let cmTimer = 0; const cmMsg = t => { $('cm-msg').textContent = t; clearTimeout(cmTimer); cmTimer = setTimeout(() => $('cm-msg').textContent = '', 3000); };
    $('cat-add-toggle').onclick = () => { const open = $('cat-manage').hidden; $('cat-manage').hidden = !open; $('cat-add-toggle').setAttribute('aria-expanded', String(open)); $('cat-add-toggle').textContent = open ? 'Done' : 'Edit types'; };
    $('cat-new').onsubmit = e => {
      e.preventDefault();
      const name = $('cat-name').value.trim(); if (!name) return;
      const same = cats.find(c => c.name.toLowerCase() === name.toLowerCase());
      if (same && !same.hidden) { cmMsg('You already have that one.'); return; }
      const id = same ? same.id : 'c' + Date.now();
      if (same) same.hidden = false; else cats.push({ id, name, color: palette[cats.length % palette.length] });
      save(K.cats, cats); renderCats(); if (!run) $('cat-select').value = id; $('cat-name').value = ''; cmMsg('Added.');
    };

    /* ---------- timer ---------- */
    const elapsedMs = () => !run ? 0 : run.accumulated + (run.paused ? 0 : Date.now() - run.startedAt);
    function tick() {
      const ms = elapsedMs(); const s = Math.floor(ms / 1000);
      const shown = target ? Math.max(0, target * 60 - s) : s;
      const h = Math.floor(shown / 3600), m = Math.floor(shown % 3600 / 60), sec = shown % 60;
      $('clock').textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
      $('clock').classList.toggle('live', !!run && !run.paused);
      // ring round the play button: fills towards the session length, or sweeps once a minute with no limit
      const prog = !run ? 0 : target ? Math.min(1, s / (target * 60)) : (s % 60) / 60;
      const fg = $('start').querySelector('.tr-fg'), back = prog < (+$('start').style.getPropertyValue('--p') || 0);
      if (fg) fg.style.transition = back ? 'none' : '';  // jump back to empty instead of winding backwards
