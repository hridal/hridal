---
import Base from '../layouts/Base.astro';
import { me } from '../data/me';
import { riddles } from '../data/riddles';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { places } from '../data/travel';
import { topics } from '../data/essays';
// Data for the Explore grid, worked out from the site's own content so it stays current.
const exp = await getCollection('experience');
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const latest = essays[0];
const countries = new Set(places.map(p => p.country)).size;
// Hand-drawn underlines on two phrases in the welcome text: one for the CV side, one for the creative side.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const marks = ['Imperial', 'Roland Berger and IBM', 'writing essays and sketching'];
const taglineHtml = marks.reduce((h, m) => h.replace(esc(m), `<span class="mark">${esc(m)}</span>`), esc(me.tagline));
// Words that rotate in the eyebrow above the name.
const flips = ['work & writing', 'projects', 'essays', 'sketches', 'ideas'];
const icons: Record<string, string> = {
  pen: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 6l3 3"/></svg>',
  music: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>',
  spark: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/></svg>',
  ball: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3.5 9c4 1 13 1 17 0M3.5 15c4-1 13-1 17 0M12 3c-3 3-3 15 0 18"/></svg>',
  book: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10.5 5 8 4.5 4 4.5v14c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2v-14c-4 0-6.5.5-8 2z"/><path d="M12 6.5v14"/></svg>',
  film: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 8h4M3 12h4M3 16h4M17 8h4M17 12h4M17 16h4"/></svg>',
};
---
<Base>
  <section class="intro">
    <div class="hero-mesh" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="eyebrow">the <span class="flip" aria-hidden="true"><span class="flip-in">{flips[0]}</span></span><span class="sr">work &amp; writing</span> of</p>
    <div class="name-row name-under">
      <h1 class="full-name"><span class="first">{me.name}</span><span class="sur"><span class="sp">{' '}</span>{me.surname}</span><em class="dot">.</em></h1>
    </div>
    <svg class="pulse" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
      <path pathLength="1" d="M0 30H420l14 0 12-22 18 44 14-34 10 12H1000" />
    </svg>
    <div class="hero-split">
      <div class="hero-copy">
        <div class="name-card dict" role="group" aria-label="What my name means">
          <p class="dict-head"><span class="word">Hridal</span> <span class="say">{me.pronunciation}</span> <span class="pos">{me.origin}</span></p>
          <ol class="mean">{me.meaning.map(m => <li>{m}</li>)}</ol>
          <p class="dict-foot">{me.etymology} {me.soundsLike.charAt(0).toUpperCase() + me.soundsLike.slice(1)}.</p>
        </div>
        <p class="tagline" set:html={taglineHtml} />
        <div class="actions"><a class="btn solid" href="/contact">Get in touch</a></div>
      </div>
      <aside class="profile" aria-label="At a glance">
        <div class="pc-top">
          <div>
            <p class="pc-name">At a glance</p>
            {me.profile.status && <p class="pc-status"><span class="live-dot" aria-hidden="true"></span>{me.profile.status}</p>}
          </div>
        </div>
        <dl class="pc-facts">
          {me.profile.rows.map(r => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
        </dl>
        <div class="pc-links">
          <a href="/experience">See experience</a>
          {me.links.filter(l => /linkedin/i.test(l.href)).map(l => <a href={l.href} target="_blank" rel="noopener">LinkedIn</a>)}
        </div>
      </aside>
    </div>
  </section>


  <section class="marquee" aria-label="Where I've worked and studied">
    <p class="mq-label">Experience with</p>
    <div class="mq-track">{[0,1].map(k => (
      <div class="mq-row" aria-hidden={k === 1 ? 'true' : undefined}>
        {[['roland-berger','Roland Berger'],['ibm','IBM'],['wood','Wood'],['imperial','Imperial College London'],['jewellness','Jewellness']].map(([f,n]) => (
          <span class="mq-item"><img src={`/logos/${f}.png`} alt={k === 0 ? n : ''} loading="lazy" width="28" height="28" /><span>{n}</span></span>
        ))}
      </div>
    ))}</div>
  </section>

  <section class="block home-now stacked-full">
    <div class="now-head">
      <h2>Currently</h2>
      <p class="updated"><span class="live-dot" aria-hidden="true"></span>Updated {me.currentlyUpdated}</p>
    </div>
    <div class="now-grid">{me.currently.map(c => (
      <div class="now-card">
        <div class="now-top"><span>{c.label}</span>{icons[c.icon] ? <i set:html={icons[c.icon]} /> : <i>{c.icon}</i>}</div>
        <p class="now-title">{c.title}</p>
        <p class="now-note">{c.note}</p>
      </div>
    ))}</div>
  </section>

  <section class="block stacked-full explore" aria-labelledby="explore-h">
    <div class="now-head"><h2 id="explore-h">Have a look around</h2></div>
    <div class="bento">
      <a class="tile b-exp spot" href="/experience">
        <span class="t-kicker">Experience</span>
        <span class="t-title">Consulting at Roland Berger, tech at IBM and engineering at Wood</span>
        <span class="t-logos">
          {[['roland-berger','Roland Berger','Junior Consultant (Intern)'],['ibm','IBM','Application Support Analyst Intern'],['wood','Wood Group','Engineering Consulting Intern'],['imperial','Imperial','AI Society, EDI rep and more']].map(([f,n,r]) => (
            <span class="t-logo" data-tip={`${n}: ${r}`}><img src={`/logos/${f}.png`} alt={n} width="44" height="44" loading="lazy" /></span>
          ))}
        </span>
        <span class="t-foot">{exp.filter(e => e.data.order <= 3).length} internships and {exp.filter(e => e.data.order > 3).length} leadership roles</span>
      </a>
      <a class="tile b-proj spot" href="/projects">
        <span class="t-kicker">Projects</span>
        <svg class="t-art" viewBox="0 0 200 80" aria-hidden="true"><path class="ta-fill" d="M6 70 C40 64 54 50 76 52 S112 30 134 32 S172 12 194 8 L194 78 L6 78Z"/><path class="ta-line" d="M6 70 C40 64 54 50 76 52 S112 30 134 32 S172 12 194 8"/><circle class="ta-dot" cx="194" cy="8" r="4"/></svg>
        <span class="t-title">{projects.length} things I've built</span>
        <span class="t-foot">{projects.map(p => p.title).join(', ')}</span>
      </a>
      <a class="tile b-ess spot" href={latest ? `/essays/${latest.id}` : '/essays'}>
        <span class="t-kicker">Latest essay</span>
        <span class="t-quote">{latest?.data.title}</span>
        <span class="t-foot">{essays.length} essays so far</span>
      </a>
      <a class="tile b-life spot" href="/life">
        <span class="t-kicker">My life</span>
        <svg class="t-globe" viewBox="0 0 80 80" aria-hidden="true"><circle cx="40" cy="40" r="30"/><g class="tg-spin"><ellipse cx="40" cy="40" rx="12" ry="30"/><path d="M10 40h60M14 26h52M14 54h52"/></g><circle class="tg-pin" cx="52" cy="30" r="3"/><circle class="tg-pin" cx="30" cy="46" r="3"/></svg>
        <span class="t-title">{places.length} cities, {countries} countries</span>
        <span class="t-foot">Plus my kitchen, my bookshelf and a study timer</span>
      </a>
      <div class="tile b-topic">
        <span class="t-kicker">Fancy writing something?</span>
        <p class="t-prompt" id="b-prompt" aria-live="polite">{topics[0]}</p>
        <span class="t-actions"><button type="button" class="t-btn" id="b-shuffle">Another prompt</button><a class="t-link" id="b-write" href={`/essays/write?topic=${encodeURIComponent(topics[0])}`}>Write about this</a></span>
      </div>
    </div>
  </section>
  <script define:vars={{ topics, flips }}>
    // Explore grid: shuffle the essay prompt.
    (() => { const el = document.getElementById('b-prompt'), go = document.getElementById('b-write');
      let last = 0; const pick = () => { let i; do { i = Math.floor(Math.random() * topics.length); } while (i === last && topics.length > 1); last = i;
        el.textContent = topics[i]; go.href = '/essays/write?topic=' + encodeURIComponent(topics[i]); el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop'); };
      document.getElementById('b-shuffle').addEventListener('click', pick); pick();
    })();
    // Eyebrow: rotate the word, unless the visitor prefers less motion.
    (() => { if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const box = document.querySelector('.eyebrow .flip'), inner = box && box.querySelector('.flip-in'); if (!inner) return;
      let i = 0; setInterval(() => { if (document.hidden) return; i = (i + 1) % flips.length;
        box.classList.add('out'); setTimeout(() => { inner.textContent = flips[i]; box.classList.remove('out'); box.classList.add('in'); requestAnimationFrame(() => requestAnimationFrame(() => box.classList.remove('in'))); }, 260);
      }, 2600);
    })();
  </script>

  <section class="riddle-wrap" id="riddle">
    <div class="envelope" role="button" tabindex="0" aria-label="Open the envelope for a riddle">
      <div class="env-back"></div>
      <div class="letter">
        <div class="letter-top"><span>A riddle, from Hridal</span><button class="shuffle" aria-label="Another riddle" title="Another riddle">↻</button></div>
        <p class="riddle-q"></p>
        <button class="reveal">Reveal the answer</button>
        <p class="riddle-a" hidden></p>
      </div>
      <div class="env-front"><i class="fl"></i><i class="fr"></i><i class="fb"></i></div>
      <div class="flap-shadow"></div>
      <div class="env-flap"></div>
      <div class="seal" aria-hidden="true"><span>H</span></div>
    </div>
    <p class="env-hint">Click the envelope to open it</p>
  </section>
  <script define:vars={{ riddles }}>
    const wrap = document.getElementById('riddle');
    const env = wrap.querySelector('.envelope');
    const q = wrap.querySelector('.riddle-q'), a = wrap.querySelector('.riddle-a'), btn = wrap.querySelector('.reveal');
    let last = -1;
    function pick() {
      let i; do { i = Math.floor(Math.random() * riddles.length); } while (i === last && riddles.length > 1);
      last = i; q.textContent = riddles[i].q; a.textContent = riddles[i].a;
      a.hidden = true; btn.hidden = false;
    }
    function open() { if (!wrap.classList.contains('open')) { wrap.classList.add('open'); env.setAttribute('aria-label', 'Riddle'); } }
    env.addEventListener('click', open);
    env.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    btn.addEventListener('click', e => { e.stopPropagation(); a.hidden = false; btn.hidden = true; });
    wrap.querySelector('.shuffle').addEventListener('click', e => { e.stopPropagation(); pick(); });
    pick();
  </script>
</Base>
