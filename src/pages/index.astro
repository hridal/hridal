---
import Base from '../layouts/Base.astro';
import { me } from '../data/me';
import { riddles } from '../data/riddles';
---
<Base>
  <section class="intro">
    <p class="eyebrow">the work &amp; writing of</p>
    <div class="name-row">
      <h1>{me.name}<em>.</em></h1>
      <div class="name-card">
        <p class="word">Hridal</p>
        <p class="say">{me.pronunciation}</p>
        <p class="pos">{me.origin}</p>
        <p class="mean">{me.meaning}</p>
        <p class="note">{me.soundsLike}</p>
      </div>
    </div>
    <p class="tagline">{me.tagline}</p>
    <div class="actions"><a class="btn solid" href="/contact">Get in touch</a><a class="btn" href="/cv.pdf" download>Download CV</a></div>
  </section>


  <section class="riddle-wrap" id="riddle">
    <div class="envelope" role="button" tabindex="0" aria-label="Open the envelope for a riddle">
      <div class="env-back"></div>
      <div class="letter">
        <div class="letter-top"><span>A riddle, from Hridal</span><button class="shuffle" aria-label="Another riddle" title="Another riddle">↻</button></div>
        <p class="riddle-q"></p>
        <button class="reveal">Reveal the answer</button>
        <p class="riddle-a" hidden></p>
      </div>
      <div class="env-front"><i class="fl"></i><i class="fr"></i><i class="fb"></i></div>
      <div class="flap-shadow"></div>
      <div class="env-flap"></div>
      <div class="seal" aria-hidden="true"><span>♥</span></div>
    </div>
    <p class="env-hint">Click the envelope to open it</p>
  </section>
  <script define:vars={{ riddles }}>
    const wrap = document.getElementById('riddle');
    const env = wrap.querySelector('.envelope');
    const q = wrap.querySelector('.riddle-q'), a = wrap.querySelector('.riddle-a'), btn = wrap.querySelector('.reveal');
    let last = -1;
    function pick() {
      let i; do { i = Math.floor(Math.random() * riddles.length); } while (i === last && riddles.length > 1);
      last = i; q.textContent = riddles[i].q; a.textContent = riddles[i].a;
      a.hidden = true; btn.hidden = false;
    }
    function open() { if (!wrap.classList.contains('open')) { wrap.classList.add('open'); env.setAttribute('aria-label', 'Riddle'); } }
    env.addEventListener('click', open);
    env.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    btn.addEventListener('click', e => { e.stopPropagation(); a.hidden = false; btn.hidden = true; });
    wrap.querySelector('.shuffle').addEventListener('click', e => { e.stopPropagation(); pick(); });
    pick();
  </script>
</Base>
