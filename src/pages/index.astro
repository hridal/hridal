---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { me } from '../data/me';
import { riddles } from '../data/riddles';
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const exp = await Promise.all((await getCollection('experience')).sort((a, b) => a.data.order - b.data.order)
  .map(async e => ({ ...e, Content: (await render(e)).Content })));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Base>
  <section class="intro">
    <p class="eyebrow">the work &amp; writing of</p>
    <h1>{me.name}<em>.</em></h1>
    <p class="tagline">{me.tagline}</p>
    <div class="actions"><a class="btn solid" href="#contact">Get in touch</a><a class="btn" href="/cv.pdf" download>Download CV</a></div>
  </section>


  <section class="riddle" id="riddle">
    <div class="riddle-label">A riddle, from Hridal <button class="shuffle" aria-label="Another riddle" title="Another riddle">↻</button></div>
    <p class="riddle-q"></p>
    <button class="reveal">Reveal the answer</button>
    <p class="riddle-a" hidden></p>
  </section>
  <script define:vars={{ riddles }}>
    const box = document.getElementById('riddle');
    const q = box.querySelector('.riddle-q'), a = box.querySelector('.riddle-a'), btn = box.querySelector('.reveal');
    let last = -1;
    function pick() {
      let i; do { i = Math.floor(Math.random() * riddles.length); } while (i === last && riddles.length > 1);
      last = i; q.textContent = riddles[i].q; a.textContent = riddles[i].a;
      a.hidden = true; btn.hidden = false;
    }
    btn.addEventListener('click', () => { a.hidden = false; btn.hidden = true; });
    box.querySelector('.shuffle').addEventListener('click', pick);
    pick();
  </script>

  <section class="block" id="about">
    <h2><span>01</span>About me</h2>
    <div>
      <div class="lead">{me.about.map(p => <p>{p}</p>)}</div>
      <div class="facts">{me.facts.map(f => <div><span>{f.label}</span><b>{f.value}</b></div>)}</div>
    </div>
  </section>

  <section class="block" id="experience">
    <h2><span>02</span>Experience</h2>
    <div>{exp.map(({ data, Content }) => (
      <div class="row">
        <div class="when">{data.period}</div>
        <div><h3>{data.role}, <em>{data.org}</em></h3><div class="body"><Content /></div></div>
      </div>
    ))}</div>
  </section>

  <section class="block" id="essays">
    <h2><span>03</span>Essays</h2>
    <ul class="list">{essays.map(e => <li><a href={`/essays/${e.id}`}><span class="t">{e.data.title}<span class="s">{e.data.summary}</span></span><time>{fmt(e.data.date)}</time></a></li>)}</ul>
  </section>

  <section class="block" id="cv">
    <h2><span>04</span>CV</h2>
    <div>
      <h4>Education</h4>
      {me.education.map(e => <div class="row"><div class="when">{e.period}</div><div><h3>{e.school}</h3><div class="body">{e.detail}</div></div></div>)}
      <h4>Projects</h4>
      {me.projects.map(p => <div class="row"><div class="when">{p.period}</div><div><h3>{p.title}</h3></div></div>)}
      <h4>Skills</h4>
      <div class="skills">{me.skills.map(s => <div><span>{s.group}</span><div class="tags">{s.items.map(i => <em>{i}</em>)}</div></div>)}</div>
      <div class="actions"><a class="btn solid" href="/cv.pdf" download>Download full CV (PDF)</a></div>
    </div>
  </section>

  <section class="contact" id="contact">
    <p class="eyebrow"><span>05</span> Contact</p>
    <a class="big" href={`mailto:${me.email}`}>{me.email}</a>
    <div class="socials">{me.links.map(l => <a href={l.href}>{l.label} ↗</a>)}</div>
  </section>
</Base>
