---
import Base from '../../layouts/Base.astro';
const projects = [
  { href: '/projects/portfolio-dashboard', title: 'Portfolio risk dashboard', kind: 'Personal project, Oct 2026 to now', img: null,
    text: 'A dashboard I built before I started investing, to see how the portfolios I was considering behave in a crash, what fees and inflation really cost, and to keep a record of my decisions. It checks its own data and rebuilds itself every weekday.' },
  { href: '/projects/jewellness', title: 'Jewellness', kind: 'Start-up, Oct 2026 to now', img: null,
    text: 'Fitness jewellery for women: a halo bracelet that tracks sleep, heart health and your cycle, with every sensor hidden in the clasp. I came up with the idea, ran the customer interviews and built the market sizing and financial model.' },
  { href: '/projects/materials-ml', title: 'Materials property predictor', kind: 'Personal project, started Oct 2025', img: null,
    text: 'A model that predicts whether a compound is a metal and estimates its band gap from the chemical formula alone, trained on nearly 5,000 real compounds. It reaches 91.9% accuracy on metal or non-metal, and you can try it in the live app.' },
];
---
<Base title="Projects" description="Things Hridal has built outside her degree, from a fitness jewellery start-up to a machine learning model that predicts the properties of materials.">
  <section class="block projects-page">
    <h2>Projects</h2>
    <div>
      <p class="lead-small">Things I have built outside my degree, with the problem, what I did and how it turned out.</p>
      <ul class="pj-list">
        {projects.map(p => (
          <li class="pj-item">
            <a href={p.href}>
              {p.img && <img src={p.img} alt="" loading="lazy" width="1100" height="619" />}
              <span class="pj-kind">{p.kind}</span>
              <span class="pj-title">{p.title}</span>
              <span class="pj-text">{p.text}</span>
              <span class="pj-more">Read more</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
