---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { me } from '../../data/me';
import { categories, currentlyWriting, topics } from '../../data/essays';
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const groups = categories.map(c => ({ ...c, items: essays.filter(e => e.data.category === c.id) })).filter(g => g.items.length);
---
<Base title="Essays">
  <div class="tab-page">
    <section class="block">
      <h2>Essays</h2>
      <div>
        <div class="why-write">
          <h3>Why I write</h3>
          <p>I realised that most of what I read in a day has already been chosen for me. The algorithm decides what comes next, and if I’m not careful I end up holding opinions I’ve borrowed from whoever posted recently. Writing pushes me the other way because you can't write an essay on autopilot without thinking about it. You have to work out what you actually think, notice where your argument is weak, and go and find out more before you can say anything. It’s a slow process, and I think that’s the best part. Half the time I start with one view and finish with a different one after doing my research, which is sort of the point.</p>
          <p>It’s also a better use of an evening than an hour of scrolling, which leaves me with nothing to show for it. An hour of writing leaves me with a draft, a clearer head and usually even a few new questions. If you want somewhere to start, scribble on the notepad below.</p>
        </div>

        <div class="essay-top">
          <div class="notepad" id="topic-gen">
            <div class="np-rings" aria-hidden="true"></div>
            <div class="np-page" id="np-page">
              <p class="np-label">Need something to write about?</p>
              <p class="topic" aria-live="polite">Scribble on the page with the pen…</p>
              <canvas id="scribble" aria-hidden="true"></canvas>
              <div class="np-pen" id="pen" aria-hidden="true">
                <svg viewBox="0 0 40 160" width="22" height="88"><rect x="10" y="10" width="20" height="104" rx="4" fill="#6c202d"/><rect x="10" y="24" width="20" height="6" fill="#fddbd3"/><rect x="27" y="14" width="4" height="46" rx="2" fill="#d9b9a8"/><path d="M10 114 L30 114 L22 146 L18 146 Z" fill="#e9d6c4"/><path d="M18 146 L22 146 L20 156 Z" fill="#3a0f17"/><rect x="10" y="4" width="20" height="10" rx="4" fill="#4a1520"/></svg>
              </div>
            </div>
            <div class="topic-actions">
              <button class="btn ghost small" id="new-topic">Or just tap here</button>
              <a class="btn small solid" id="send-topic" href="/essays/write">Write about this</a>
              <button class="btn ghost small" id="share-topic">Share this topic</button>
            </div>
            <p class="topic-note">Write it right here on the site. I read everything that comes in and publish my favourites below.</p>
          </div>
          <div class="writing-card">
            <p class="eyebrow">Currently writing</p>
            <p class="w-title">{currentlyWriting.title}</p>
            {currentlyWriting.subtitle && <p class="w-sub">{currentlyWriting.subtitle}</p>}
            <p class="w-stage">Stage: research</p>
            <p class="w-note">{currentlyWriting.note}</p>
            <span class="w-pen">✎</span>
          </div>
        </div>

        {groups.map(g => (
          <div class="essay-group">
            <h4>{g.name}</h4>
            <p class="group-blurb">{g.blurb}</p>
            <ul class="list">{g.items.map(e => <li><a href={`/essays/${e.id}`}><span class="t">{e.data.title}<span class="s">{e.data.summary}</span></span><time>{fmt(e.data.date)}</time></a></li>)}</ul>
          </div>
        ))}
        <div class="essay-group" id="from-readers" hidden>
          <h4>From readers</h4>
          <p class="group-blurb">Essays people wrote on these topics and sent in.</p>
          <ul class="list" id="readers-list"></ul>
        </div>
      </div>
    </section>
  </div>
  <script define:vars={{ topics, email: me.email }}>
    const el = document.querySelector('#topic-gen .topic');
    const send = document.getElementById('send-topic');
    const share = document.getElementById('share-topic');
    let current = '', last = -1;
    function pick() {
      let i; do { i = Math.floor(Math.random() * topics.length); } while (i === last && topics.length > 1);
      last = i; current = topics[i];
      el.textContent = current; el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop');
      send.href = `/essays/write?topic=${encodeURIComponent(current)}`;
    }
    document.getElementById('new-topic').addEventListener('click', pick);

    // scribble-to-generate
    const page = document.getElementById('np-page');
    const cv = document.getElementById('scribble');
    const pen = document.getElementById('pen');
    const ctx = cv.getContext('2d');
    let drawing = false, lastPt = null, ink = 0;
    function fit() { const r = page.getBoundingClientRect(), d = window.devicePixelRatio || 1; cv.width = r.width * d; cv.height = r.height * d; ctx.setTransform(d, 0, 0, d, 0, 0); }
    fit(); window.addEventListener('resize', fit);
    const pos = e => { const r = page.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
    function movePen(p) { pen.style.transform = `translate(${p.x - 4}px, ${p.y - 86}px) rotate(18deg)`; pen.classList.add('held'); }
    cv.addEventListener('pointerdown', e => { drawing = true; lastPt = pos(e); cv.setPointerCapture(e.pointerId); movePen(lastPt); cv.classList.remove('fade'); });
    cv.addEventListener('pointermove', e => {
      const p = pos(e); movePen(p);
      if (!drawing) return;
      ctx.strokeStyle = 'rgba(108,32,45,.75)'; ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
      ctx.beginPath(); ctx.moveTo(lastPt.x, lastPt.y); ctx.lineTo(p.x, p.y); ctx.stroke();
      ink += Math.hypot(p.x - lastPt.x, p.y - lastPt.y); lastPt = p;
      if (ink > 450) { ink = 0; drawing = false; pick(); cv.classList.add('fade'); setTimeout(() => { ctx.clearRect(0, 0, cv.width, cv.height); cv.classList.remove('fade'); }, 700); }
    });
    const stop = () => { drawing = false; };
    cv.addEventListener('pointerup', stop); cv.addEventListener('pointercancel', stop);
    cv.addEventListener('pointerleave', () => { pen.classList.remove('held'); pen.style.transform = ''; });
    share.addEventListener('click', async () => {
      if (!current) pick();
      const text = `Essay topic from Hridal: "${current}". Fancy writing about it?`;
      try {
        if (navigator.share) await navigator.share({ text, url: location.href });
        else { await navigator.clipboard.writeText(text + ' ' + location.href); share.textContent = 'Copied!'; setTimeout(() => share.textContent = 'Share this topic', 1500); }
      } catch (e) {}
    });
    fetch('/api/essays').then(r => r.json()).then(d => {
      if (!d.enabled || !d.essays || !d.essays.length) return;
      const ul = document.getElementById('readers-list');
      d.essays.forEach(e => {
        const li = document.createElement('li'), a = document.createElement('a');
        a.href = '/essays/read?id=' + encodeURIComponent(e.id);
        const t = document.createElement('span'); t.className = 't'; t.textContent = e.title;
        const sub = document.createElement('span'); sub.className = 's'; sub.textContent = 'By ' + e.name + (e.topic ? ', on ' + e.topic : '');
        t.appendChild(sub);
        const tm = document.createElement('time'); tm.textContent = new Date(+e.created).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
        a.append(t, tm); li.appendChild(a); ul.appendChild(li);
      });
      document.getElementById('from-readers').hidden = false;
    }).catch(() => {});
  </script>
</Base>
