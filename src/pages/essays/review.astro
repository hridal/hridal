---
import Base from '../../layouts/Base.astro';
---
<Base title="Review submissions">
  <meta name="robots" content="noindex" slot="head" />
  <div class="tab-page review-page">
    <section class="block">
      <h2>Review</h2>
      <div>
        <form class="rv-login" id="rv-login">
          <label for="rv-pw">Password</label>
          <input id="rv-pw" type="password" autocomplete="current-password" />
          <button class="btn solid" type="submit">Show submissions</button>
        </form>
        <p class="pf-msg" id="rv-msg" role="status"></p>
        <div id="rv-list"></div>
        <div id="rv-pub" hidden><h3 class="rv-head">Published</h3><div id="rv-pub-list"></div></div>
      </div>
    </section>
  </div>
  <script>
  import { renderEssay } from '../../scripts/essay-format';
  {
    const list = document.getElementById('rv-list'), msg = document.getElementById('rv-msg');
    let pw = sessionStorage.getItem('hridal.rv') || '';
    const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    async function load() {
      const r = await fetch('/api/essays?pending=1', { headers: { 'x-admin-password': pw } }); const d = await r.json();
      if (!d.enabled && !d.error) { msg.textContent = 'The database isn’t connected yet.'; return; }
      if (d.error) { msg.textContent = d.error; return; }
      sessionStorage.setItem('hridal.rv', pw); document.getElementById('rv-login').hidden = true; loadPublished();
      msg.textContent = d.essays.length ? `${d.essays.length} waiting for you.` : 'Nothing waiting. All caught up.';
      list.innerHTML = d.essays.map(e => `<article class="rv-item" data-id="${esc(e.id)}"><h3>${esc(e.title)}</h3><p class="rv-meta">By ${esc(e.name)}${e.topic ? ', on ' + esc(e.topic) : ''}</p>
        <div class="rv-body"></div>
        <div class="rv-actions"><button class="btn solid" data-act="publish">Publish</button><button class="btn" data-act="remove">Remove</button></div></article>`).join('');
      list.querySelectorAll('.rv-item').forEach((el, i) => renderEssay(d.essays[i].body || '', el.querySelector('.rv-body')));
      list.querySelectorAll('[data-act]').forEach(b => b.addEventListener('click', async () => {
        const item = b.closest('.rv-item'); b.disabled = true;
        await fetch('/api/essays', { method: 'POST', headers: { 'content-type': 'application/json', 'x-admin-password': pw }, body: JSON.stringify({ action: b.dataset.act, id: item.dataset.id }) });
        item.remove(); msg.textContent = b.dataset.act === 'publish' ? 'Published.' : 'Removed.'; loadPublished();
      }));
    }
    async function loadPublished() {
      const d = await (await fetch('/api/essays')).json();
      const wrap = document.getElementById('rv-pub'), box = document.getElementById('rv-pub-list');
      box.innerHTML = (d.essays || []).map(e => `<article class="rv-item rv-small" data-id="${esc(e.id)}"><h3><a href="/essays/read?id=${encodeURIComponent(e.id)}" target="_blank">${esc(e.title)}</a></h3><p class="rv-meta">By ${esc(e.name)}</p><div class="rv-actions"><button class="btn" data-del>Delete</button></div></article>`).join('');
      wrap.hidden = !(d.essays || []).length;
      box.querySelectorAll('[data-del]').forEach(b => b.addEventListener('click', async () => {
        const item = b.closest('.rv-item');
        if (!confirm('Delete this essay from the site? This can’t be undone.')) return;
        b.disabled = true;
        await fetch('/api/essays', { method: 'POST', headers: { 'content-type': 'application/json', 'x-admin-password': pw }, body: JSON.stringify({ action: 'remove', id: item.dataset.id }) });
        item.remove(); msg.textContent = 'Deleted.'; if (!box.children.length) wrap.hidden = true;
      }));
    }
    document.getElementById('rv-login').addEventListener('submit', e => { e.preventDefault(); pw = document.getElementById('rv-pw').value; load(); });
    if (pw) load();
  }
  </script>
</Base>
