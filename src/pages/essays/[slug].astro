---
import Post from '../../layouts/Post.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('essays')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Post title={entry.data.title} date={entry.data.date} summary={entry.data.summary}><Content /><p class="back"><a href="/essays">← All essays</a></p></Post>
