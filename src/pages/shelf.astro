---
import Base from '../layouts/Base.astro';
import { books, films } from '../data/shelf';
import { motifs } from '../data/motifs';
const starPath = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z';
// Each spine gets its own height and width so the row looks like a real shelf, not a grid.
const H = [92, 84, 96, 88, 80, 94, 86, 90];
const Wd = [54, 46, 60, 50, 44, 56, 48, 52];
const bookItems = books.map((b, i) => ({ ...b, key: 'b:' + b.id, line: b.author, done: b.status === 'read', now: 'Reading now', h: H[i % H.length], w: Wd[i % Wd.length] }));
const filmItems = films.map(f => ({ ...f, key: 'f:' + f.id, line: [f.kind === 'series' ? 'Series' : 'Film', f.year, f.where].filter(Boolean).join(', '), done: f.status === 'watched', now: 'Watching now' }));
const all = [...bookItems, ...filmItems];
---
<Base title="Shelf" description="Books I've read and films I've watched, with my ratings and yours.">
  <div class="tab-page shelf-page">
    <section class="block">
      <div class="side">
        <h2>Shelf</h2>
        <nav class="toc" aria-label="On this page"><a href="#books">Books</a><a href="#films">Films and series</a></nav>
      </div>
      <div>
        <p class="lead-small">My favourite reads of 2026 and what I have been watching. Pick one to read what I thought and add your own rating.</p>

        <h4 id="books">Books</h4>
        <div class="bookcase">
          <div class="bc-row" role="listbox" aria-label="Books">
            {bookItems.map((b, i) => (
              <button class="spine" role="option" aria-selected={i === 0 ? 'true' : 'false'} data-key={b.key}
                style={`--cloth:${(b as any).cover || '#6c202d'};--h:${b.h}%;--w:${b.w}px`} aria-label={`${b.title} by ${b.line}`}>
                <span class="sp-band" aria-hidden="true"></span>
                <span class="sp-title">{b.title}</span>
                <span class="sp-author">{b.line.split(' ').slice(-1)[0]}</span>
                <span class="sp-band low" aria-hidden="true"></span>
              </button>
            ))}
            <span class="bc-end" aria-hidden="true"></span>
          </div>
          <div class="bc-plank" aria-hidden="true"></div>
        </div>

        <h4 id="films">Films and series</h4>
        <div class="tickets" role="listbox" aria-label="Films and series">
          {filmItems.map((f, i) => (
            <button class="ticket" role="option" aria-selected="false" data-key={f.key} aria-label={f.title}>
              <span class="tk-l"><span>Admit one</span></span>
              <span class="tk-r">
                <span class="tk-t">{f.title}</span>
                <span class="tk-m">{f.line}</span>
              </span>
              {motifs[f.id] && <svg class="tk-ico" viewBox="0 0 100 100" aria-hidden="true" set:html={motifs[f.id]} />}
            </button>
          ))}
        </div>

        <div class="detail-wrap" aria-live="polite">
          {all.map((it, i) => (
            <article class="detail" data-key={it.key} hidden={i !== 0}>
              {motifs[it.id] && <svg class="dt-ico" viewBox="0 0 100 100" aria-hidden="true" set:html={motifs[it.id]} />}
              <div class="dt-body">
                <p class="dt-kind">{it.key.startsWith('b:') ? 'Book' : 'Film or series'}{!it.done && `, ${it.now.toLowerCase()}`}</p>
                <h3 class="dt-title">{it.title}</h3>
                <p class="dt-line">{it.line}</p>
                {it.done && it.rating && (
                  <p class="dt-mine"><span class="stars" style={`--v:${it.rating / 5}`} aria-label={`My rating ${it.rating} out of 5`}>
                    <span class="stars-base">{[0,1,2,3,4].map(() => <svg viewBox="0 0 24 24"><path d={starPath}/></svg>)}</span>
                    <span class="stars-fill">{[0,1,2,3,4].map(() => <svg viewBox="0 0 24 24"><path d={starPath}/></svg>)}</span>
                  </span><span class="dt-score">{it.rating} out of 5</span></p>
                )}
                {it.review && <p class="dt-review">{it.review}</p>}
                <div class="dt-rate">
                  <span class="dt-label">Your rating</span>
                  <span class="rate" role="radiogroup" aria-label={`Rate ${it.title}`}>
                    {[1,2,3,4,5].map(n => <span class="rate-star" role="radio" tabindex="0" aria-checked="false" aria-label={`${n} star${n > 1 ? 's' : ''}`}><svg viewBox="0 0 24 24"><path d={starPath}/></svg></span>)}
                  </span>
                  <span class="sb-avg"></span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    const LS = 'hridal.shelf.mine';
    const mine: Record<string, number> = (() => { try { return JSON.parse(localStorage.getItem(LS) || '{}'); } catch { return {}; } })();
    const saveMine = () => { try { localStorage.setItem(LS, JSON.stringify(mine)); } catch {} };
    let shared: Record<string, { sum: number; count: number }> | null = null;
    const pickers = [...document.querySelectorAll<HTMLButtonElement>('.spine, .ticket')];
    const details = [...document.querySelectorAll<HTMLElement>('.detail')];
    const wrap = document.querySelector<HTMLElement>('.detail-wrap')!;

    function select(key: string, scroll = false) {
      pickers.forEach(p => p.setAttribute('aria-selected', String(p.dataset.key === key)));
      details.forEach(d => d.hidden = d.dataset.key !== key);
      if (scroll && innerWidth < 760) wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    pickers.forEach(p => p.addEventListener('click', () => select(p.dataset.key!, true)));

    function setAvg(d: HTMLElement, lead = '') {
      const key = d.dataset.key!, el = d.querySelector<HTMLElement>('.sb-avg')!, t = shared?.[key];
      const avg = t && t.count ? `${(t.sum / t.count).toFixed(1)} from ${t.count} ${t.count === 1 ? 'person' : 'people'}` : '';
      el.textContent = [lead, avg].filter(Boolean).join(' ') || (mine[key] ? `You gave it ${mine[key]}.` : 'Be the first to rate it.');
    }
    details.forEach(d => {
      const key = d.dataset.key!, stars = [...d.querySelectorAll<HTMLElement>('.rate-star')];
      const paint = (n: number, cls = 'on') => stars.forEach((s, i) => s.classList.toggle(cls, i < n));
      paint(mine[key] || 0);
      stars.forEach((s, i) => {
        s.addEventListener('pointerenter', () => paint(i + 1, 'hover'));
        s.addEventListener('pointerleave', () => paint(0, 'hover'));
        const pick = async () => {
          if (mine[key]) { setAvg(d, 'You have already rated this.'); return; }
          mine[key] = i + 1; saveMine(); paint(i + 1);
          stars.forEach((x, j) => x.setAttribute('aria-checked', String(j === i)));
          try { const r = await fetch('/api/ratings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: key, stars: i + 1, vid: window.hridalVid && window.hridalVid() }) }); const j = await r.json(); if (j.enabled) shared = j.ratings; } catch {}
          setAvg(d, 'Thanks for rating.');
        };
        s.addEventListener('click', pick);
        s.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); } });
      });
    });
    fetch('/api/ratings').then(r => r.json()).then(j => { if (j.enabled) shared = j.ratings; }).catch(() => {}).finally(() => details.forEach(d => setAvg(d)));
  </script>
</Base>
