---
import Base from '../layouts/Base.astro';
import { recipes, favourites, moods, whereLabels } from '../data/kitchen';
const favs = favourites.map(id => recipes.find(r => r.id === id)).filter(Boolean);
---
<Base title="Kitchen">
  <div class="tab-page">
    <section class="block stacked-full tool-page">
      <h2>Kitchen</h2>
      <div>
        <p class="lead-small">Easy, healthy vegetarian food for busy weeknights. These are the meals I keep going back to, plus a little helper for when you can't decide what's for dinner.</p>

        <h4>My favourite weeknight meals</h4>
        <div class="fav-meals">{favs.map(r => (
          <div class="meal-wrap">
            <button class="meal-card" data-id={r!.id}>
              <span class="mc-time">{r!.minutes} minutes, serves {r!.serves}</span>
              <span class="mc-name">{r!.name}</span>
              <span class="mc-blurb">{r!.blurb}</span>
              <span class="mc-link">See the recipe</span>
            </button>
            <button class="heart" type="button" data-heart={r!.id} aria-pressed="false" aria-label={`Save ${r!.name}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10.1A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.8c0 5.5-7.5 10.1-7.5 10.1z"/></svg><span class="hc"></span></button>
          </div>
        ))}</div>

        <div class="saved-recipes" id="saved" hidden>
          <h4>Your saved recipes</h4>
          <div class="saved-list" id="saved-list"></div>
          <p class="saved-note">Saved in this browser. Open one to copy it into your notes.</p>
        </div>

        <h3 class="cb-title">What should I make tonight?</h3>
        <div class="cupboard" id="picker">
          <div class="cb-cornice"></div>
          <div class="cb-body">
            <div class="cb-inner">
              <div class="cb-shelf">
                <p class="shelf-label">What are you in the mood for?</p>
                <div class="chips jars" id="moods">{moods.map(m => <button class="chip jar" data-mood={m.id}><span>{m.label}</span></button>)}</div>
              </div>
              <div class="cb-shelf">
                <p class="shelf-label">How much time have you got?</p>
                <div class="chips jars" id="times">
                  <button class="chip jar on" data-time="999"><span>Any</span></button>
                  <button class="chip jar" data-time="20"><span>20 min or less</span></button>
                  <button class="chip jar" data-time="30"><span>30 min or less</span></button>
                </div>
              </div>
            </div>
            <button class="cb-door left" aria-label="Open the cupboard"><span class="door-panel"></span><span class="knob"></span></button>
            <button class="cb-door right" aria-label="Open the cupboard"><span class="door-panel"></span><span class="knob"></span></button>
          </div>
          <div class="cb-plinth"></div>
          <p class="env-hint cb-hint">Open the cupboard</p>
        </div>

        <div class="stove" id="stove">
          <div class="pan-wrap" aria-hidden="true">
            <div class="steam"><i></i><i></i><i></i></div>
            <div class="pan">
              <div class="pan-handle"></div>
              <div class="pan-body"></div>
              <div class="pan-rim"><div class="pan-broth"><div class="pan-letters" id="pan-letters"></div></div></div>
            </div>
            <div class="hob"></div>
          </div>
          <p class="pan-note" id="pan-note">Pick a jar and its letters go in the pan.</p>
          <div class="pk-actions"><button class="btn solid" id="suggest">Cook something up</button><span class="pk-count" id="count"></span></div>
        </div>

        <div id="recipe-out" class="recipe" hidden></div>
      </div>
    </section>
  </div>

  <script define:vars={{ recipes, whereLabels, HEART: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10.1A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.8c0 5.5-7.5 10.1-7.5 10.1z"/></svg>' }}>
    const out = document.getElementById('recipe-out');
    const count = document.getElementById('count');
    let mood = null, time = 999, lastId = null;
    const esc = s => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    function show(r, matches) {
      const groups = {};
      r.ingredients.forEach(i => (groups[i.where] = groups[i.where] || []).push(i.item));
      out.innerHTML = `
        <div class="rc-head">
          <div><p class="eyebrow">${r.minutes} minutes, serves ${r.serves}. Protein from ${esc(r.protein.toLowerCase())}.</p>
          <h3>${esc(r.name)}</h3><p class="rc-blurb">${esc(r.blurb)}</p></div>
          <div class="rc-actions">
            <button class="heart big" type="button" data-heart="${r.id}" aria-pressed="false" aria-label="Save ${esc(r.name)}">${HEART}<span class="hl">Save</span><span class="hc"></span></button>
            <button class="btn" type="button" id="copy-recipe">Copy recipe</button>
            ${matches > 1 ? '<button class="btn" id="another">Try another</button>' : ''}
          </div>
        </div>
        <div class="rc-body">
          <div><h5>Ingredients</h5><ul>${r.ingredients.map(i => `<li>${esc(i.item)}</li>`).join('')}</ul></div>
          <div><h5>Where to get it</h5>${Object.entries(groups).map(([w, items]) => `<p class="rc-where"><b>${esc(whereLabels[w] || w)}</b>${items.map(esc).join(', ')}</p>`).join('')}</div>
          <div class="rc-steps"><h5>Method</h5><ol>${r.steps.map(s => `<li>${esc(s)}</li>`).join('')}</ol></div>
        </div>`;
      out.hidden = false; lastId = r.id; paintHearts();
      document.getElementById('copy-recipe').addEventListener('click', e => copyRecipe(r, e.currentTarget));
      const again = document.getElementById('another');
      if (again) again.addEventListener('click', suggest);
      out.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function matching() { return recipes.filter(r => (!mood || r.mood.includes(mood)) && r.minutes <= time); }
    function suggest() {
      const list = matching();
      if (!list.length) { out.hidden = false; out.innerHTML = '<p class="rc-blurb">Nothing matches that combination yet. Try more time or a different mood.</p>'; return; }
      const pool = list.length > 1 ? list.filter(r => r.id !== lastId) : list;
      show(pool[Math.floor(Math.random() * pool.length)], list.length);
    }
    function updateCount() { const n = matching().length; count.textContent = `${n} recipe${n === 1 ? '' : 's'} match`; }

    document.querySelectorAll('#moods .chip').forEach(b => b.addEventListener('click', () => {
      const on = b.classList.contains('on');
      document.querySelectorAll('#moods .chip').forEach(x => x.classList.remove('on'));
      if (!on) b.classList.add('on'); mood = on ? null : b.dataset.mood; updateCount();
      window.pour && window.pour(b, !on, 'mood');
    }));
    document.querySelectorAll('#times .chip').forEach(b => b.addEventListener('click', () => {
      const was = b.classList.contains('on');
      document.querySelectorAll('#times .chip').forEach(x => x.classList.remove('on'));
      b.classList.add('on'); time = +b.dataset.time; updateCount();
      if (!was) window.pour && window.pour(b, b.dataset.time !== '999', 'time');
    }));
    document.getElementById('suggest').addEventListener('click', () => window.cookUp ? window.cookUp(suggest) : suggest());
    document.querySelectorAll('.meal-card').forEach(c => c.addEventListener('click', () => show(recipes.find(r => r.id === c.dataset.id), 1)));
    const cb = document.getElementById('picker');
    cb.querySelectorAll('.cb-door').forEach(d => d.addEventListener('click', () => cb.classList.add('open')));
    updateCount();

    // ---------- Hearts: save a recipe to your own list, and see how many visitors saved it ----------
    const KEY = 'hridal.kitchen.saved';
    let saved = []; try { saved = JSON.parse(localStorage.getItem(KEY) || '[]').filter(id => recipes.some(r => r.id === id)); } catch (e) {}
    let hearts = {}, shared = false;
    const keep = () => { try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {} };
    function paintHearts() {
      document.querySelectorAll('[data-heart]').forEach(b => {
        const id = b.dataset.heart, on = saved.includes(id), n = hearts[id] || 0;
        b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on));
        const name = (recipes.find(r => r.id === id) || {}).name || 'recipe';
        b.setAttribute('aria-label', (on ? 'Saved: ' : 'Save ') + name + (shared && n ? `, saved by ${n} visitor${n === 1 ? '' : 's'}` : ''));
        const hc = b.querySelector('.hc'); if (hc) hc.textContent = shared && n ? n : '';
        const hl = b.querySelector('.hl'); if (hl) hl.textContent = on ? 'Saved' : 'Save';
      });
      const list = saved.map(id => recipes.find(r => r.id === id)).filter(Boolean);
      document.getElementById('saved').hidden = !list.length;
      document.getElementById('saved-list').innerHTML = list.map(r => `<button class="saved-chip" type="button" data-open="${r.id}"><span>${esc(r.name)}</span><em>${r.minutes} min</em></button>`).join('');
      document.querySelectorAll('[data-open]').forEach(b => b.onclick = () => show(recipes.find(r => r.id === b.dataset.open), 1));
    }
    document.addEventListener('click', async e => {
      const b = e.target.closest && e.target.closest('[data-heart]'); if (!b) return;
      e.preventDefault(); e.stopPropagation();
      const id = b.dataset.heart, on = !saved.includes(id);
      saved = on ? [...saved, id] : saved.filter(x => x !== id); keep();
      if (shared) hearts[id] = Math.max(0, (hearts[id] || 0) + (on ? 1 : -1));
      paintHearts();
      if (on) { b.classList.remove('pop'); void b.offsetWidth; b.classList.add('pop'); }
      try { const j = await (await fetch('/api/tally', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: 'heart', id, on, vid: window.hridalVid && window.hridalVid() }) })).json(); if (j.counts) { hearts = j.counts; paintHearts(); } } catch (err) {}
    }, true);
    fetch('/api/tally?kind=heart').then(r => r.json()).then(j => { shared = !!j.enabled; hearts = j.counts || {}; paintHearts(); }).catch(() => {});
    paintHearts();

    // ---------- Copy a recipe as plain text, ready to paste into notes or a message ----------
    function recipeText(r) {
      return [r.name, `${r.minutes} minutes, serves ${r.serves}`, '', 'Ingredients', ...r.ingredients.map(i => '- ' + i.item), '', 'Method', ...r.steps.map((s, i) => `${i + 1}. ${s}`), '', 'From hridal.com/kitchen'].join('\n');
    }
    async function copyRecipe(r, btn) {
      const text = recipeText(r); let ok = false;
      try { await navigator.clipboard.writeText(text); ok = true; } catch (e) {
        const t = document.createElement('textarea'); t.value = text; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0'; document.body.appendChild(t); t.select();
        try { ok = document.execCommand('copy'); } catch (e2) {} t.remove();
      }
      btn.textContent = ok ? 'Copied! Paste it anywhere' : 'Couldn’t copy, try again';
      setTimeout(() => { btn.textContent = 'Copy recipe'; }, 2600);
    }
  </script>
  <script>
    import { gsap } from 'gsap';
    const pan = document.getElementById('pan-letters')!;
    const note = document.getElementById('pan-note')!;
    const stove = document.getElementById('stove')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function scoopOut(group: string) {
      const old = [...pan.querySelectorAll<HTMLElement>(`[data-group="${group}"]`)];
      if (!old.length) return;
      gsap.to(old, { y: -18, opacity: 0, duration: 0.35, stagger: 0.01, onComplete: () => old.forEach(o => o.remove()) });
    }

    function refreshNote() {
      const n = pan.children.length;
      stove.classList.toggle('simmering', n > 0);
      note.textContent = n ? 'Ready when you are.' : 'Pick a jar and its letters go in the pan.';
    }

    (window as any).pour = (jar: HTMLElement, adding: boolean, group: string) => {
      scoopOut(group);
      if (!adding) { setTimeout(refreshNote, 400); return; }
      const label = (jar.querySelector('span')?.textContent || '').replace(/\s+/g, '');
      const from = jar.getBoundingClientRect();
      const mouth = pan.getBoundingClientRect();
      if (!reduce) gsap.timeline().to(jar, { rotate: -38, y: -6, transformOrigin: '50% 100%', duration: 0.3, ease: 'power2.out' })
        .to(jar, { rotate: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' }, '+=0.35');
      [...label].forEach((ch, k) => {
        const land = () => {
          const l = document.createElement('span');
          l.className = 'pan-letter'; l.dataset.group = group; l.textContent = ch;
          l.style.left = (8 + Math.random() * 84) + '%'; l.style.top = (18 + Math.random() * 52) + '%';
          l.style.setProperty('--r', (Math.random() * 60 - 30) + 'deg');
          pan.appendChild(l);
          gsap.from(l, { scale: 1.6, y: -8, duration: 0.35, ease: 'back.out(3)' });
          refreshNote();
        };
        if (reduce) { land(); return; }
        const f = document.createElement('span');
        f.className = 'fly-letter'; f.textContent = ch;
        document.body.appendChild(f);
        const sx = from.left + from.width * (0.3 + Math.random() * 0.2), sy = from.top + 4;
        const tx = mouth.left + mouth.width * (0.2 + Math.random() * 0.6), ty = mouth.top + mouth.height * 0.45;
        gsap.set(f, { x: sx, y: sy });
        gsap.timeline({ delay: 0.22 + k * 0.045, onComplete: () => { f.remove(); land(); } })
          .to(f, { x: sx - 14 - Math.random() * 18, y: sy - 10 - Math.random() * 10, rotate: -40, duration: 0.18, ease: 'power1.out' })
          .to(f, { x: tx, duration: 0.75, ease: 'none' }, '>')
          .to(f, { y: ty, rotate: Math.random() * 360, duration: 0.75, ease: 'power2.in' }, '<');
      });
    };

    (window as any).cookUp = (serve: () => void) => {
      const letters = [...pan.querySelectorAll<HTMLElement>('.pan-letter')];
      if (reduce || !letters.length) { serve(); return; }
      stove.classList.add('cooking');
      note.textContent = 'Cooking\u2026';
      const tl = gsap.timeline({ onComplete: () => { letters.forEach(l => l.remove()); stove.classList.remove('cooking'); refreshNote(); serve(); } });
      tl.to('.pan', { x: 3, duration: 0.06, repeat: 13, yoyo: true, ease: 'sine.inOut' }, 0)
        .to(letters, { y: () => -6 - Math.random() * 10, duration: 0.18, repeat: 5, yoyo: true, stagger: { each: 0.02, from: 'random' }, ease: 'sine.inOut' }, 0)
        .to(letters, { scale: 0, opacity: 0, rotate: '+=180', duration: 0.4, stagger: { each: 0.015, from: 'random' }, ease: 'power2.in' }, 0.95);
    };
  </script>
</Base>
