---
import Base from '../layouts/Base.astro';
const sections = [
  { id: 'kitchen', title: 'Kitchen', href: '/kitchen', cta: 'Open the kitchen',
    left: 'Easy, healthy vegetarian food for busy weeknights.',
    right: 'The meals I keep going back to, plus a cupboard that helps you decide what to cook tonight.' },
  { id: 'travel', title: 'Travel', href: '/travel', cta: 'Spin the globe',
    left: 'Every place I’ve been, on a globe that follows the real sun.',
    right: 'Every light is somewhere I\u2019ve been. Tap one to take a closer look.' },
  { id: 'shelf', title: 'Shelf', href: '/shelf', cta: 'Browse the shelf',
    left: 'Books I\u2019ve read and things I\u2019ve watched, with my ratings.',
    right: 'Pick any of them to read what I thought, then leave your own rating.' },
  { id: 'focus', title: 'Focus', href: '/focus', cta: 'Start the clock',
    left: 'A study timer, a calendar and a to-do list in one.',
    right: 'Track the hours you put into each module or project and see your week fill up.' },
];
const doodles: Record<string, string> = {
  kitchen: '<path d="M30 44h60v6c0 12-10 20-30 20s-30-8-30-20z"/><path d="M24 44h72M48 36c-4-6 4-8 0-14M60 36c-4-6 4-8 0-14M72 36c-4-6 4-8 0-14"/>',
  travel: '<circle cx="60" cy="40" r="28"/><path d="M32 40h56M60 12c-12 14-12 42 0 56M60 12c12 14 12 42 0 56M36 26h48M36 54h48"/>',
  shelf: '<path d="M30 66h60M34 66V22h12v44M46 66V30h12v36M60 66l10-40 11 3-10 40M86 66V18"/><path d="M38 30h4M50 38h4"/>',
  focus: '<circle cx="60" cy="42" r="26"/><path d="M60 26v16l10 8M52 12h16M60 12v4"/>',
};
---
<Base title="My life" description="The things Hridal does outside work: cooking, travel, reading and how she studies.">
  <div class="tab-page life">
    <section class="block">
      <div class="side">
        <h2>My life</h2>
      </div>
      <div>
        <p class="lead-small">The things I do outside work, from the food I cook to the places I have been and the books I keep going back to.</p>
        <ol class="life-index">
          {sections.map(s => (
            <li>
              <a class="li-row" href={s.href}>
                <svg class="li-art" viewBox="0 0 120 80" aria-hidden="true" set:html={doodles[s.id]} />
                <span class="li-text">
                  <span class="li-title">{s.title}</span>
                  <span class="li-desc">{s.left} {s.right}</span>
                </span>
                <span class="li-go">{s.cta}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</Base>
