---
import Base from '../layouts/Base.astro';
import { places } from '../data/travel';
import { books, films } from '../data/shelf';
import { recipes } from '../data/kitchen';
// At-a-glance counts for the left column, worked out from the site's own data so they stay current.
const glance = [
  { n: new Set(places.map(p => p.country)).size, label: 'countries visited', href: '/travel' },
  { n: places.length, label: 'cities on the globe', href: '/travel' },
  { n: books.length, label: 'books on the shelf', href: '/shelf' },
  { n: films.length, label: 'films and series rated', href: '/shelf' },
  { n: recipes.length, label: 'recipes in the kitchen', href: '/kitchen' },
];
const sections = [
  { id: 'kitchen', title: 'Kitchen', href: '/kitchen', cta: 'Open the kitchen',
    left: 'Easy, healthy vegetarian food for busy weeknights.',
    right: 'Open the cupboard when you can\u2019t decide what to make, heart the recipes you like so they\u2019re saved for later, and copy any of them straight into your notes.' },
  { id: 'travel', title: 'Travel', href: '/travel', cta: 'Spin the globe',
    left: 'Every city I\u2019ve been to, on a globe that follows the real sun.',
    right: 'Tap a light to look closer, and if you\u2019ve been there too, add yourself and see how many other visitors have.' },
  { id: 'shelf', title: 'Shelf', href: '/shelf', cta: 'Browse the shelf',
    left: 'Books I\u2019ve read and things I\u2019ve watched, with what I thought of each.',
    right: 'Leave your own rating and see how other visitors scored them.' },
  { id: 'focus', title: 'Study with me', href: '/focus', cta: 'Pull up a chair',
    left: 'When I\u2019m studying, the lamp in this room is on and you can see what I\u2019m working on.',
    right: 'Take a seat, say what you\u2019re doing and work alongside me, and your time goes into a calendar of your own.' },
];
const doodles: Record<string, string> = {
  kitchen: '<path d="M30 44h60v6c0 12-10 20-30 20s-30-8-30-20z"/><path d="M24 44h72M48 36c-4-6 4-8 0-14M60 36c-4-6 4-8 0-14M72 36c-4-6 4-8 0-14"/>',
  travel: '<circle cx="60" cy="40" r="28"/><path d="M32 40h56M60 12c-12 14-12 42 0 56M60 12c12 14 12 42 0 56M36 26h48M36 54h48"/>',
  shelf: '<path d="M30 66h60M34 66V22h12v44M46 66V30h12v36M60 66l10-40 11 3-10 40M86 66V18"/><path d="M38 30h4M50 38h4"/>',
  focus: '<circle cx="60" cy="42" r="26"/><path d="M60 26v16l10 8M52 12h16M60 12v4"/>',
};
---
<Base title="Hang out" description="The parts of Hridal's life you can join in with: her kitchen, a globe of where she's been, her bookshelf and a room to study with her.">
  <div class="tab-page life">
    <section class="block">
      <div class="side">
        <h2>Hang out</h2>
        <ul class="glance" aria-label="At a glance">
          {glance.map(g => (
            <li><a href={g.href}><b data-count={g.n}>{g.n}</b><span>{g.label}</span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="lead-small">The parts of my life you can join in with, from what I cook and where I’ve been to what I’m reading and when I’m studying.</p>
        <ol class="life-index">
          {sections.map(s => (
            <li>
              <a class="li-row" href={s.href}>
                <svg class="li-art" viewBox="0 0 120 80" aria-hidden="true" set:html={doodles[s.id]} />
                <span class="li-text">
                  <span class="li-title">{s.title}</span>
                  <span class="li-desc">{s.left} {s.right}</span>
                </span>
                <span class="li-go">{s.cta}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</Base>
