---
import Base from './Base.astro';
const { title, date, summary, extra } = Astro.props;
const d = new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={title} description={summary}>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="meta">{d}{extra && <> · {extra}</>}</div>
    </header>
    <div class="prose"><slot /></div>
  </article>
</Base>
