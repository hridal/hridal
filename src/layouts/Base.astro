---
import '../styles/global.css';
import { me } from '../data/me';
const { title, description = me.tagline } = Astro.props;
const links = [['about','About'],['now','Currently'],['experience','Experience'],['essays','Essays'],['contact','Contact']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · hridal` : `hridal — ${me.name}`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" />
</head>
<body>
  <div class="wrap">
    <header class="top">
      <a class="mark" href="/">hridal<span>.</span></a>
      <nav>{links.map(([id, label]) => <a href={`/#${id}`}>{label}</a>)}</nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>© {new Date().getFullYear()} {me.name}</span>
      <span>{me.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}</span>
    </footer>
  </div>
</body>
</html>
