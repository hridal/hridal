---
import '@fontsource/pinyon-script';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';
import { me } from '../data/me';
const { title, description = me.tagline } = Astro.props;
const links = [['/about','About'],['/experience','Experience'],['/essays','Essays'],['/contact','Contact']];
const lifeLinks = [['/kitchen','Kitchen'],['/travel','Travel'],['/focus','Focus']];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} | Hridal` : `Hridal Gujrati`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" />
  <script is:inline>document.documentElement.classList.add('js'); setTimeout(function(){ document.documentElement.classList.add('motion-ready'); }, 2500);</script>
</head>
<body>
  <div class="wrap">
    <header class="top">
      <a class="mark" href="/">hridal<span>.</span></a>
      <button class="menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav"><i class="mb-label">Menu</i><b class="mb-icon"><span></span><span></span><span></span></b></button>
      <nav id="site-nav">
        {links.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        <div class={`dd${lifeLinks.some(([h]) => here.startsWith(h)) ? ' dd-current' : ''}`}>
          <button class="dd-btn" type="button" aria-expanded="false" aria-haspopup="true">My life <span class="dd-caret" aria-hidden="true">▾</span></button>
          <div class="dd-menu">{lifeLinks.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}</div>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>© {new Date().getFullYear()} {me.name}</span>
      <span>{me.links.map((l, i) => <>{i > 0 && ', '}<a href={l.href}>{l.label}</a></>)}</span>
    </footer>
  </div>
  <script is:inline>
    (() => { const b = document.getElementById('menu-btn'), h = b && b.closest('.top');
      if (!b) return;
      document.querySelectorAll('.dd').forEach(dd => {
        const btn = dd.querySelector('.dd-btn');
        btn.addEventListener('click', e => { e.stopPropagation(); const open = dd.classList.toggle('open'); btn.setAttribute('aria-expanded', open); });
      });
      document.addEventListener('click', e => { document.querySelectorAll('.dd.open').forEach(dd => { if (!dd.contains(e.target)) { dd.classList.remove('open'); dd.querySelector('.dd-btn').setAttribute('aria-expanded', 'false'); } }); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.dd.open').forEach(dd => dd.classList.remove('open')); });
      b.addEventListener('click', () => { const open = h.classList.toggle('menu-open'); b.setAttribute('aria-expanded', open); b.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); });
    })();
  </script>
  <script>import '../scripts/motion.ts';</script>
</body>
</html>
