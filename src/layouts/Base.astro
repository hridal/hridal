---
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/dancing-script';
import '@fontsource/mrs-saint-delafield';
import '../styles/global.css';
import '../styles/premium.css';
import { getCollection } from 'astro:content';
import { me } from '../data/me';
import { projects } from '../data/projects';
const { title, description = me.tagline } = Astro.props;
const links = [['/about','About'],['/experience','Experience'],['/projects','Projects'],['/essays','Essays']];
const lifeLinks = [['/kitchen','Kitchen'],['/travel','Travel'],['/shelf','Shelf'],['/focus','Focus']];
// Pen path for the sign-off signature, traced by hand through the letters in writing order (one entry per pen stroke).
const penStrokes = ["M48 35 C 40 30, 24 28, 20 22 C 17 15, 30 10, 45 10 C 58 10, 66 14, 64 24 C 62 34, 58 44, 50 55 C 42 65, 22 86, 14 92 C 10 94, 11 89, 17 83 C 25 75, 35 67, 42 62", "M48 56 C 60 50, 72 44, 82 33 C 92 23, 100 14, 107 10 C 111 8, 106 15, 100 21 C 92 30, 76 42, 68 52 C 61 62, 55 72, 57 79 C 62 82, 70 78, 74 74", "M80 72 C 83 67, 86 62, 88 59 C 91 56, 97 56, 96 61 C 93 64, 88 70, 84 78 C 86 80, 92 75, 97 70 C 99 67, 101 64, 101 64 C 100 69, 99 75, 100 79 C 103 80, 106 77, 110 74 C 114 70, 119 68, 121 72 C 122 76, 117 80, 113 79 C 110 78, 112 73, 118 70 C 132 54, 150 34, 161 21 C 155 33, 141 56, 132 72 C 127 78, 128 80, 132 78 C 136 76, 142 66, 150 64 C 157 63, 159 68, 155 74 C 151 79, 143 81, 141 77 C 140 71, 150 65, 158 64 C 156 70, 152 77, 154 79 C 156 80, 165 75, 172 70 C 182 60, 198 40, 210 28 C 214 24, 216 27, 212 32 C 202 44, 188 60, 180 72 C 177 78, 180 81, 186 79 C 194 76, 200 70, 203 67", "M114 55 L116 52"];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// Everything the quick-jump menu (Cmd/Ctrl + K) can take you to.
const essays = (await getCollection('essays')).filter(e => !e.data.draft).sort((a, b) => +b.data.date - +a.data.date);
const jump = [
  ...[['/', 'Home'], ...links, ['/life', 'My life'], ['/contact', 'Contact']].map(([href, label]) => ({ href, label, group: 'Pages' })),
  ...lifeLinks.map(([href, label]) => ({ href, label, group: 'My life' })),
  ...projects.map(p => ({ href: p.href, label: p.title, group: 'Projects' })),
  ...essays.map(e => ({ href: `/essays/${e.id}`, label: e.data.title, group: 'Essays' })),
];
---
<!doctype html>
<html lang="en">
<head>
  <meta name="view-transition" content="same-origin" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} | Hridal Gujrati` : `Hridal Gujrati, Materials Science and Engineering at Imperial`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <meta name="theme-color" content="#fbfaf8" />
  <meta name="author" content="Hridal Gujrati" />
  <link rel="canonical" href={new URL(Astro.url.pathname, 'https://hridal.com')} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hridal Gujrati" />
  <meta property="og:title" content={title ? `${title} | Hridal Gujrati` : 'Hridal Gujrati'} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, 'https://hridal.com')} />
  <meta property="og:image" content="https://hridal.com/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.add('js'); setTimeout(function(){ document.documentElement.classList.add('motion-ready'); }, 2500);</script>
  <slot name="head" />
</head>
<body>
  <div class="wrap">
    <header class="top">
      <a class="mark" href="/">hridal<span>.</span></a>
      <button class="menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav"><i class="mb-label">Menu</i><b class="mb-icon"><span></span><span></span><span></span></b></button>
      <nav id="site-nav">
        {links.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        <a href="/life" aria-current={['/life', ...lifeLinks.map(([h]) => h)].some(h => here.startsWith(h)) ? 'page' : undefined}>My life</a>
        <a href="/contact" aria-current={here.startsWith('/contact') ? 'page' : undefined}>Contact</a>
        <button class="k-btn" type="button" data-k-open aria-label="Search the site">Search <kbd>⌘K</kbd></button>
      </nav>
    </header>
    <main><slot /></main>
    <div class="signoff" aria-label={`Thanks for stopping by, ${me.name}`}>
      <p class="so-thanks">Thanks for stopping by,</p>
      <svg class="so-sign" viewBox="0 0 300 110" aria-hidden="true"><defs><mask id="so-ink" maskUnits="userSpaceOnUse" x="-20" y="-20" width="340" height="150">{penStrokes.map(d => <path class="so-ps" d={d} />)}</mask></defs><g transform="rotate(-8 150 55)"><text x="14" y="80" mask="url(#so-ink)">{me.name}</text><path class="so-swoosh" d="M4 98 C 60 96, 150 80, 294 42" /><g class="so-pen"><path d="M0 0 L3 -9 L10 -29 L15 -27 L8 -7 Z" fill="#1d1b1c"/><path d="M0 0 L3 -9 L5.4 -8.2 Z" fill="#c9a24a"/><path d="M10 -29 L15 -27 L16 -30 L11 -32 Z" fill="#c9a24a"/></g></g></svg>
      <button class="to-top" type="button" aria-label="Back to the top of the page"><span aria-hidden="true">↑</span> Back to top</button>
    </div>
    <div class="footer-mark" aria-hidden="true">hridal.</div>
    <footer>
      <span>© {new Date().getFullYear()} {me.name} {me.surname}</span>
      <span>{me.links.map((l, i) => <>{i > 0 && ', '}<a href={l.href}>{l.label}</a></>)}</span>
    </footer>
  </div>
  <script is:inline>
    (() => { const b = document.getElementById('menu-btn'), h = b && b.closest('.top');
      if (!b) return;
      document.querySelectorAll('.dd').forEach(dd => {
        const btn = dd.querySelector('.dd-btn');
        btn.addEventListener('click', e => { e.stopPropagation(); const open = dd.classList.toggle('open'); btn.setAttribute('aria-expanded', open); });
      });
      document.addEventListener('click', e => { document.querySelectorAll('.dd.open').forEach(dd => { if (!dd.contains(e.target)) { dd.classList.remove('open'); dd.querySelector('.dd-btn').setAttribute('aria-expanded', 'false'); } }); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.dd.open').forEach(dd => dd.classList.remove('open')); });
      b.addEventListener('click', () => { const open = h.classList.toggle('menu-open'); b.setAttribute('aria-expanded', open); b.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); });
    })();
  </script>
  <dialog class="k-menu" id="k-menu" aria-label="Search the site">
    <form method="dialog" class="k-form" role="search">
      <input id="k-input" type="search" placeholder="Search pages, projects and essays" autocomplete="off" aria-controls="k-list" aria-label="Search the site" />
      <kbd class="k-esc">esc</kbd>
    </form>
    <ul id="k-list" class="k-list" role="listbox">
      {jump.map(j => <li role="option" data-group={j.group}><a href={j.href}><span>{j.label}</span><em>{j.group}</em></a></li>)}
    </ul>
    <p class="k-empty" hidden>Nothing matches. Try a shorter word.</p>
  </dialog>
  <script>import '../scripts/motion.ts'; import '../scripts/premium.ts';</script>
</body>
</html>
